<template>
  <header
    :class="[
      'fixed top-0 w-full z-50 transition-all duration-500',
      scrolled ? 'bg-white shadow-lg' : 'bg-transparent'
    ]"
  >
    <!-- NAV -->
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 py-3 sm:py-4 flex justify-between items-center">

      <!-- LOGO -->
      <div
        class="logo-container transition-all duration-500"
        :class="scrolled ? 'logo-bg' : ''"
      >
        <div class="logo-text">Soinsolar</div>
      </div>

      <!-- LINKS DESKTOP -->
      <div class="hidden md:flex gap-4 lg:gap-6 items-center">
        <a
          href="#servicios"
          @click.prevent="scrollToSection('servicios')"
          :class="navClass"
          class="text-sm lg:text-base"
        >
          Servicios
        </a>

        <a
          href="#casos-exito"
          @click.prevent="scrollToSection('casos-exito')"
          :class="navClass"
          class="text-sm lg:text-base"
        >
          Proyectos
        </a>

        <button
          ref="brochureBtn"
          @click="explodeParticles"
          class="px-4 lg:px-6 py-2 rounded-full font-semibold transition-all duration-300
                 bg-black text-[#F5B027] text-sm lg:text-base
                 hover:bg-white hover:text-black relative overflow-visible"
        >
          <span class="relative z-10 whitespace-nowrap">Brochure dinámico</span>
        </button>
      </div>

      <!-- BOTÓN MENÚ MÓVIL -->
      <button
        @click="menuOpen = !menuOpen"
        class="md:hidden text-2xl sm:text-3xl focus:outline-none z-50"
        :class="scrolled ? 'text-black' : 'text-white'"
        aria-label="Menu"
      >
        {{ menuOpen ? '✕' : '☰' }}
      </button>
    </nav>

    <!-- MENÚ MÓVIL -->
    <transition name="fade">
      <div
        v-if="menuOpen"
        class="md:hidden bg-white shadow-xl px-6 py-6 space-y-5"
      >
        <a
          @click="goTo('servicios')"
          class="block text-slate-700 text-base sm:text-lg font-medium hover:text-[#F5B027] transition cursor-pointer"
        >
          Servicios
        </a>

        <a
          @click="goTo('casos-exito')"
          class="block text-slate-700 text-base sm:text-lg font-medium hover:text-[#F5B027] transition cursor-pointer"
        >
          Proyectos
        </a>

        <button
          @click="explodeParticlesMobile"
          class="w-full px-6 py-3 rounded-full font-semibold
                 bg-black text-[#F5B027] hover:bg-[#F5B027] hover:text-black transition"
        >
          Brochure dinámico
        </button>
      </div>
    </transition>
  </header>
</template>

<script setup>
import { ref, onMounted, onUnmounted, computed } from 'vue'
import gsap from 'gsap'

const scrolled = ref(false)
const menuOpen = ref(false)
const brochureBtn = ref(null)

/* Detectar scroll */
const onScroll = () => {
  scrolled.value = window.scrollY > 50
}

onMounted(() => window.addEventListener('scroll', onScroll))
onUnmounted(() => window.removeEventListener('scroll', onScroll))

/* Estilos de links */
const navClass = computed(() =>
  scrolled.value
    ? 'text-slate-700 hover:text-[#F5B027] transition-all duration-300 cursor-pointer font-medium'
    : 'text-white hover:text-[#F5B027] transition-all duration-300 cursor-pointer font-medium'
)

/* Scroll suave */
const scrollToSection = (sectionId) => {
  const element = document.getElementById(sectionId)
  if (!element) return

  const navbarHeight = 80
  const offset = element.getBoundingClientRect().top + window.pageYOffset - navbarHeight

  window.scrollTo({
    top: offset,
    behavior: 'smooth'
  })
}

/* Navegación móvil */
const goTo = (id) => {
  menuOpen.value = false
  scrollToSection(id)
}

/* Partículas */
const explodeParticles = () => {
  if (!brochureBtn.value) return

  const btn = brochureBtn.value
  const rect = btn.getBoundingClientRect()

  for (let i = 0; i < 30; i++) {
    const particle = document.createElement('span')
    particle.className = 'particle'
    particle.style.left = `${rect.width / 2}px`
    particle.style.top = `${rect.height / 2}px`
    btn.appendChild(particle)

    const angle = Math.random() * Math.PI * 2
    const dist = 60 + Math.random() * 40

    gsap.to(particle, {
      x: Math.cos(angle) * dist,
      y: Math.sin(angle) * dist,
      opacity: 0,
      scale: 0,
      duration: 0.5,
      ease: 'power3.out',
      onComplete: () => particle.remove()
    })
  }

  // Aquí abre el PDF o lo que necesites
  console.log('Brochure dinámico clicked')
}

const explodeParticlesMobile = () => {
  menuOpen.value = false
  console.log('Brochure dinámico clicked (mobile)')
}
</script>

<style scoped>
/* Logo */
.logo-text {
  font-size: 1.25rem;
  font-weight: 700;
  background: linear-gradient(135deg, #F5B027 0%, #FFB800 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.logo-container {
  padding: 5px 8px;
  border-radius: 9999px;
  transition: all 0.3s ease;
}

@media (min-width: 640px) {
  .logo-container {
    padding: 6px 10px;
  }
}

.logo-bg {
  background: rgba(245, 176, 39, 0.95);
  backdrop-filter: blur(4px);
}

.logo-bg .logo-text {
  -webkit-text-fill-color: #001F3F;
  background: none;
}

/* Partículas */
.particle {
  position: absolute;
  width: 8px;
  height: 8px;
  background: radial-gradient(circle, #F5B027 0%, #FFB800 70%);
  border-radius: 50%;
  pointer-events: none;
  transform: translate(-50%, -50%);
}

/* Animación menú móvil */
.fade-enter-active,
.fade-leave-active {
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.fade-enter-from,
.fade-leave-to {
  opacity: 0;
  transform: translateY(-10px);
}
</style>
